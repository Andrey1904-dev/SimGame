<!--
  Опциональный проект для прогона тестов ВНЕ Unity (dotnet run).
  В Unity этот .csproj не используется и не компилируется.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>LifeFromZero.UI.Tests</AssemblyName>
    <RootNamespace>LifeFromZero.UI.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Core/**/*.cs" />
    <Compile Include="**/*.cs" />
  </ItemGroup>

</Project>
